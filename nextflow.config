manifest {
    author = 'Nicolas Chiaruttini'
    description = 'Pipeline for CZI processing with BigStitcher and BrainReg'
    version = '0.1.0-SNAPSHOT'
}

params {
    // Default for local development
    fiji_cache_dir = "${projectDir}/work/fiji_mouse_czi_processing"
    env_cache_dir = "${projectDir}/work/envs"
    atlas_cache_dir = "${projectDir}/work/atlas"
    models_dir = "${projectDir}/work/models"

    input = null  // Will be overridden by command line

    // SSH connection and data layout
    ssh_host = "lmsmith@haas056.rcp.epfl.ch"
    input_base_path = "/mnt/lsens-data"        // Root of input data tree
    output_base_path = "/mnt/lsens-analysis"    // Root of output/analysis tree
    user_name = null    // Required for output publishing, e.g. "First_Last"
    analysis_subfolder = null  // Optional nesting on the NAS: <user_name>/<analysis_subfolder>/<brain_id>/
    brain_id = null     // Shorthand input, e.g. "MS181" or "MS181,LS010"
    dry_run = false     // If true, print resolved paths and exit without processing
    check_voxels = false // If true, stage files and extract original voxel sizes, then exit
    // Pipeline steps all run by default. Use these flags to skip individual steps:
    skip_registration          = false  // skip brainreg registration
    skip_ome_zarr              = false  // skip ch1 -> OME-Zarr conversion (also skips spotiflow)
    skip_spotiflow             = false  // skip spotiflow spot detection (Kuma GPU)
    skip_results_transfer      = false  // skip publishing XMLs + fused channels to the NAS
    skip_registration_transfer = false  // skip copying registration results (and registration_qc) to the NAS
    skip_registration_selection = false // skip scoring the sweep / picking the best registration (also skips points-to-atlas)
    skip_points_to_atlas       = false  // skip transforming the spotiflow detections with the chosen registration

    // Max number of concurrent haas<->cluster transfers (stage/publish/copy steps).
    // 1 = serialize them (avoids bandwidth/disk contention to the SMB share).
    max_concurrent_transfers = 1

    // Where to send the run-summary notice (OK / FAILURES + path of the report
    // file, via a Slurm job mail). Set to null (or --notify_email false) to
    // disable; the report file is always written regardless.
    notify_email = "lana.smith@epfl.ch"

    ome_zarr_output_base = "${projectDir}/work"   // group-derived under -profile slurm

    // Spotiflow spot detection — runs on the Kuma GPU cluster (h100) over SSH,
    // after the OME-Zarr is published to the shared /work (skip with --skip_spotiflow).
    kuma_host        = "lmsmith@kuma.hpc.epfl.ch"
    spotiflow_version = "spotiflow_lsfm_v6_scratch_preds"   // output folder: <user>/detection_results/<spotiflow_version>/<brain>
    spotiflow_model  = "spotiflow_scratch_annotated_clean_20251211_cropsize64_grid1_sigma3"   // model dir name under models_dir
    spotiflow_sbatch = "${projectDir}/bin/sbatch_spotiflow.batch"

    bigstitcher {
        
        channel_alignment {
            pairwise_shifts_downsamples {
                x = 4
                y = 4
                z = 2
            }
            filter_min_r = 0.7
        }
        
        tile_alignment {
            use_channel = 0
            pairwise_shifts_downsamples {
                x = 4
                y = 4
                z = 2
            }
            filter_min_r = 0.7
        }
        
        icp_refinement {
            icp_refinement_type = "Simple (all together)"
            downsampling = "Downsampling 8/8/4"
            interest = "Average Threshold"
            icp_max_error = "Normal Adjustment (<5px)"
        }
        
        reorientation {
            raw_orientation = "IPR"
            reorient_to_asr = false
        }
        
        fusion_config {
            downsample=1
            fusion_method = "SMOOTH AVERAGE"
        }
    }

    brainreg {
        // Single valued parameters
        atlas = "perens_lsfm_mouse_20um"
        backend = "niftyreg"
        channel_used_for_registration = 0
        affine_n_steps = 6
        affine_use_n_steps = 5
        freeform_n_steps = 6
        freeform_use_n_steps = 4
        smoothing_sigma_reference = -1.0
        histogram_n_bins_floating = 128
        histogram_n_bins_reference = 128
        n_free_cpus = 2
        debug = false
        save_original_orientation = true
        brain_geometry = "full"
        sort_input_file = true
        pre_processing = "default"

        // Sweepable parameters. Use one value and keep brackets if you don't want to sweep
        // It's possible to transfer other parameters to sweepable ones but this requires changes in the code
        bending_energy_weight = [0.7, 0.8, 0.9] // Sweepable
        grid_spacing = [-20,-30, -40] // Sweepable  
        smoothing_sigma_floating = ['-1'] //Sweepable
    }

    // Choosing the best registration of the sweep (bin/registration_select.py).
    // Quality levels are a prior from the 21-brain cfos cohort:
    // acceptable = median - 2 MAD, failed = median - 3 MAD (brain-space Dice).
    registration_qc {
        display_channel = 1            // downsampled channel drawn under the boundaries in the figures
        tau = 0.005                    // Dice differences below this are ties -> smoothest warp wins
        prior_median = 0.974
        prior_mad = 0.0055
        catastrophic_dice = 0.90       // below this the registration failed, whatever the cohort
        flat_spread = 0.06             // failed and flatter than this -> affine/input problem
        distortion_prior_median = 0.033  // variants with distortion_sd > 2x this are rejected
        mask_clip_max = 0.02           // tissue mask suspect if the artefact clip removes more
    }

}

// Don't let one bad brain abort the whole batch: retry a task once (covers
// transient node/IO hiccups), then `ignore` it. An ignored failure drops that
// brain's downstream steps but lets every other brain keep running. All
// failures are captured in the trace and reported by the onComplete handler.
process {
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
    maxRetries = 1
}

// Fixed-name execution trace, parsed by the onComplete handler in main.nf to
// build the failure report. (Run without `-with-trace` to avoid a duplicate.)
trace {
    enabled = true
    overwrite = true
    file = 'pipeline_trace.txt'
    fields = 'task_id,hash,name,status,exit,submit,duration,realtime,workdir'
}

// The run-summary notification is sent as a Slurm job mail (see
// workflow.onComplete in main.nf): the login nodes' sendmail has no relay and
// EPFL's SMTP relay needs authentication, so Nextflow's own mailer can't deliver.

profiles {
    local {
        params {
            fiji_cache_dir = "${projectDir}/work/fiji_mouse_czi_processing"
            // OME-Zarr publish target and spotiflow need the cluster (/work + Kuma GPU),
            // so skip them for local runs (override with --skip_ome_zarr false if needed).
            skip_ome_zarr  = true
            skip_spotiflow = true
            skip_points_to_atlas = true   // detections live on /work
        }
        apptainer.enabled = true
        apptainer.autoMounts = true
        process.executor = 'local'
        
        // Set cache directory to avoid the warning
        apptainer.cacheDir = "$HOME/.apptainer/cache"
    }
    
    slurm {
        process {
            executor = 'slurm'
            queue = 'standard'
            memory = '64 GB'
            cpus = 16
            time = '4h'
            
            withName: 'publishInitialXmlToSource|publishStitchedXmlToSource|publishOmeZarr|copyResultsToImageFolder|publishRegistrationQcToSource|publishDetectionsToSource' {
                executor = 'local'  // Explicit override
                memory = '2 GB'
                cpus = 1
            }

            // Spotiflow runs on Kuma; this Jed-side process submits over SSH and
            // then polls for hours. It must run on a compute node, NOT the login
            // node, whose watchdog SIGTERMs long-running processes (~4h).
            withName: 'spotiflowDetectKuma' {
                executor = 'slurm'
                queue = 'standard'
                cpus = 1
                memory = '2 GB'
                time = '1d'     // outlive the Kuma GPU job (~4.5h typical)
            }

            // Serialize haas<->cluster transfers (one file at a time) to avoid
            // bandwidth/disk contention on the SMB share. Tune with
            // --max_concurrent_transfers (default 1).
            withName: 'stageFilesRSyncSSH|stageFusedCh1|publishInitialXmlToSource|publishStitchedXmlToSource|publishFusedChannelsToSource|copyResultsToImageFolder|publishRegistrationQcToSource|publishDetectionsToSource' {
                maxForks = params.max_concurrent_transfers
            }

            // CZI download from haas can take many hours for large brains: give it
            // a small but long-running compute-node job (the 4h default would kill
            // it, and the login node's watchdog kills long processes too).
            withName: 'stageFilesRSyncSSH' {
                executor = 'slurm'
                queue = 'standard'
                cpus = 2
                memory = '8 GB'
                time = '12h'
            }

            // Heavy fused-channel uploads run on a compute node (not the busy
            // login node) for far better network throughput.
            withName: 'publishFusedChannelsToSource' {
                executor = 'slurm'
                queue = 'standard'
                cpus = 2
                memory = '8 GB'
                time = '12h'
            }

            withName: 'alignChannelsWithBigstitcher|alignTilesWithBigstitcher|fuseBigStitcherDataset|convertTiffToOmeZarr' {
                executor = 'slurm'  // Explicitly set executor
                queue = 'bigmem'
                memory = '480 GB'
                cpus = 40
                time = '8h'
            }

            withName: 'icpRefinementWithBigstitcher' {
                executor = 'slurm'
                queue = 'standard'
                memory = '96 GB'
                time = '12h'
            }

            // Scores every sweep variant of one brain (~8 GB) and draws the figures
            withName: 'selectBestRegistration' {
                executor = 'slurm'
                queue = 'standard'
                cpus = 8
                memory = '54 GB'   // standard partition caps at 7000 MB/CPU
                time = '4h'
            }

            // Single-threaded deformation-field lookup over ~1M points
            withName: 'transformPointsToAtlas' {
                executor = 'slurm'
                queue = 'standard'
                cpus = 4
                memory = '24 GB'
                time = '3h'
            }

            withName: 'brainregRunRegistration' {
                executor = 'slurm'
                queue = 'bigmem'
                memory = '150 GB'
                cpus = 32
                time = '8h'
            }
        }
       
        workDir = "/scratch/${System.getProperty('user.name')}/nf"
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.cacheDir = "/work/${['id', '-gn'].execute().text.trim().replaceAll('-unit$', '')}/apptainer_cache" // you can replace ${['id', '-gn'].execute().text.trim().replaceAll('-unit$', '')} with the name of your group if this does not work (for instance ptbiop afaiac)
       
        params {
            fiji_cache_dir = "/work/${['id', '-gn'].execute().text.trim().replaceAll('-unit$', '')}/fiji_mouse_czi_processing"
            env_cache_dir = "/work/${['id', '-gn'].execute().text.trim().replaceAll('-unit$', '')}/envs"
            atlas_cache_dir = "/work/${['id', '-gn'].execute().text.trim().replaceAll('-unit$', '')}/atlas"
            models_dir = "/work/${['id', '-gn'].execute().text.trim().replaceAll('-unit$', '')}/models"
            ome_zarr_output_base = "/work/${['id', '-gn'].execute().text.trim().replaceAll('-unit$', '')}"
        }
    }

    test {
        params.input = "${projectDir}/test_data/Small.czi" // This file is located here and has been renamed: https://zenodo.org/records/8305531/files/Demo%20LISH%204x8%2015pct%20647.czi
        params.bigstitcher.channel_alignment.filter_min_r = 0.5
    }
}

env {
  FIJI_PATH = '/path/to/your/Fiji.app'
}
